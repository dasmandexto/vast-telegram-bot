# ==============================================================================
# Vast.ai Telegram Bot Configuration
# ==============================================================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Vast.ai API Key (from https://cloud.vast.ai/manage-keys/)
VAST_API_KEY=your_vast_api_key_here

# Allowed Telegram User IDs (comma-separated list of integer IDs from @userinfobot)
ADMIN_IDS=123456789,987654321

# Optional Settings
VAST_API_BASE_URL=https://console.vast.ai
LOG_LEVEL=INFO
